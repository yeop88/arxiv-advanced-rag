# ===========================================================================
# 환경변수 템플릿 — 복사해서 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env   (Windows: copy .env.example .env)
# ===========================================================================

# --- LLM 백엔드 선택: "anthropic" 또는 "openai" ---
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# 생성/검증에 쓰는 메인 모델 (정확도 중요)
LLM_MODEL=claude-opus-5-5
# 질의변환 등 가벼운 작업용 모델 (비용 절감)
LLM_MODEL_LIGHT=claude-haiku-5-5
# API effort(추론 깊이): low | medium | high | xhigh | max  — 비우면 API 기본값(medium)
LLM_EFFORT=

# --- OpenAI (대안 백엔드) ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_MODEL_LIGHT=gpt-4o-mini

# --- 임베딩 모델 (HuggingFace, 로컬) ---
# bge-m3: 한국어+영어 멀티링구얼, 검색 성능 우수
EMBED_MODEL=BAAI/bge-m3

# --- 리랭커 (크로스인코더, 로컬) ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 벡터 DB 저장 경로 ---
CHROMA_DIR=./storage/chroma

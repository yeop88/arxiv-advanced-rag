# ===========================================================================
# 환경변수 템플릿 — 복사해서 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# 기본값: FreeToken Local(OpenAI 호환 로컬 서버)의 Qwen3.6-35B-A3B 를 사용합니다.
# Claude / OpenAI 로 바꾸려면 아래 "대안 백엔드" 섹션을 참고하세요.
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM 백엔드 선택 (LLM_PROVIDER) — 하나만 고릅니다
#   local     : FreeToken Local 등 OpenAI 호환 로컬 서버  → LOCAL_BASE_URL, LLM_MODEL 필요  [기본]
#   anthropic : Claude API                               → ANTHROPIC_API_KEY 필요
#   openai    : OpenAI API                               → OPENAI_API_KEY 필요
# 바꿀 때는 LLM_MODEL / LLM_MODEL_LIGHT / effort 설정도 그 백엔드에 맞게 함께 바꿉니다.
# ---------------------------------------------------------------------------
LLM_PROVIDER=local

# ---------------------------------------------------------------------------
# FreeToken Local (OpenAI 호환)
#   1) FreeToken 앱의 서버/API 설정에서 주소를 확인해 LOCAL_BASE_URL 에 넣는다(/v1 까지).
#   2) curl <LOCAL_BASE_URL>/models 로 확인 → 응답의 "id" 를 LLM_MODEL 에 그대로 넣는다.
# ---------------------------------------------------------------------------
LOCAL_BASE_URL=http://localhost:1919/v1   # ← 8000 은 예시. FreeToken 에 표시된 주소로 바꾸세요
LOCAL_API_KEY=EMPTY                       # 인증 없는 서버면 아무 값(키를 요구하면 그 값)

# 메인 모델(생성·검증) / 경량 모델(질의변환). 모델이 하나뿐이면 둘 다 같은 id.
LLM_MODEL=Qwen3.6-35B-A3B
LLM_MODEL_LIGHT=Qwen3.6-35B-A3B

# Qwen 권장 temperature: thinking 0.6 / non-thinking 0.7  (0.0 은 같은 말 반복 위험)
LLM_TEMPERATURE=0.6
# 응답 최대 토큰. thinking 은 추론 토큰까지 포함하므로 4096 이면 답이 잘릴 수 있음
LLM_MAX_TOKENS=8192

# Effort(Qwen3 계열): 등급형이 아니라 thinking on | off  (chat_template_kwargs.enable_thinking)
#   메인은 켜서 정확도↑, 경량(질의변환)은 꺼서 속도↑. 비우면 서버 기본값.
#   서버가 이 신호를 지원하지 않으면 무시될 수 있음.
LOCAL_THINKING=on
LOCAL_THINKING_LIGHT=off

# ===========================================================================
# 대안 백엔드 — 쓰려면 LLM_PROVIDER 를 바꾸고 해당 블록의 주석을 푸세요.
#   effort 는 provider 마다 파라미터 이름·값 체계가 달라 따로 설정합니다(메인 / _LIGHT).
#   (LLM_MODEL / LLM_MODEL_LIGHT / LLM_TEMPERATURE 도 그 provider 에 맞게 바꿔야 함)
# ===========================================================================

# --- Anthropic (Claude) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_MODEL_LIGHT=claude-haiku-5-5
# output_config.effort: low | medium | high | xhigh | max   (opus/haiku 5.x 기본 medium)
# ANTHROPIC_EFFORT=
# ANTHROPIC_EFFORT_LIGHT=

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-5
# LLM_MODEL_LIGHT=gpt-5-mini
# reasoning_effort: none | minimal | low | medium | high | xhigh  (추론 모델 전용, 지원값은 모델별로 다름)
# OPENAI_REASONING_EFFORT=
# OPENAI_REASONING_EFFORT_LIGHT=

# ===========================================================================
# 벡터 DB: "chroma"(로컬 파일, 기본) | "pinecone"(원격)
#   Pinecone 으로 바꾸는 순서:
#     1) PINECONE_API_KEY 입력
#     2) python scripts/migrate_to_pinecone.py --dry-run   (점검)
#     3) python scripts/migrate_to_pinecone.py             (Chroma 벡터를 그대로 복사, 재임베딩 없음)
#     4) python eval/vector_parity.py                      (Chroma 와 검색 결과 동일성 확인)
#     5) VECTOR_BACKEND=pinecone
#   원문은 DOCSTORE_PATH(로컬 JSONL)에도 저장됨 — BM25 하이브리드 검색에 필요하니 지우지 말 것.
# ===========================================================================
VECTOR_BACKEND=chroma

# --- Pinecone (VECTOR_BACKEND=pinecone 또는 이전 스크립트 실행 시 필요) ---
# API 키: Pinecone 콘솔(app.pinecone.io) → API Keys 에서 발급. 보통 pcsk_ 로 시작
PINECONE_API_KEY=
# 인덱스 이름: 없으면 이전 스크립트가 cosine·1024차원(bge-m3)으로 자동 생성
PINECONE_INDEX=arxiv-rag
# 네임스페이스: 한 인덱스 안에서 데이터를 나누는 이름
PINECONE_NAMESPACE=arxiv
# 서버리스 인덱스 위치(새로 만들 때만 사용). 무료 플랜은 aws / us-east-1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# 원문 보관 파일(로컬). Pinecone 사용 시 BM25 하이브리드 검색에 필요하니 지우지 말 것
DOCSTORE_PATH=./storage/docstore.jsonl
# 사내 프록시 때문에 "CERTIFICATE_VERIFY_FAILED" 가 나면: python scripts/export_ca_bundle.py
#   → storage/ca_bundle.pem 생성(비워 두면 이 파일을 자동 사용). 다른 경로면 여기에 지정
CA_BUNDLE=

# ===========================================================================
# 논문 자동 수집: 근거가 부족하면 arXiv 에서 논문을 찾아 전문을 DB 에 추가(챗봇 사이드바에서도 켜고 끔)
# ===========================================================================
AUTO_FETCH=1
# 리랭크 최고 점수가 이 값보다 낮으면 '근거 부족'(평가셋으로 보정한 값)
AUTO_FETCH_THRESHOLD=0.2
# 후보 논문의 (질문, 제목+초록) 관련도가 이 값 이상인 것만 추가
AUTO_FETCH_MIN_SCORE=0.3
AUTO_FETCH_MAX_PAPERS=3
# 검색어당 후보 논문 수. 적으면 원 논문이 후보에서 잘림
AUTO_FETCH_CANDIDATES=20
# 1 이면 인용 수 순 검색을 후보에 더하고, 관련도가 ANCHOR_SCORE 이상인 후보 중 최다 인용 논문을 우선 선정
AUTO_FETCH_CITATION_SEARCH=1
AUTO_FETCH_ANCHOR_SCORE=0.5
# 자동 수집 청크 예산(0 = 제한 없음). 넘으면 오래 안 쓰인 논문부터 삭제
AUTO_FETCH_MAX_CHUNKS=2000
# 1 이면 수집 논문의 참고문헌·부록을 DB 에 넣지 않음
AUTO_FETCH_DROP_BACK_MATTER=1
# 자동 수집 논문 청크의 리랭크 점수에 곱하는 값. 1.0 = 그대로, 낮추면 기존 논문이 우선
AUTO_RERANK_WEIGHT=0.7
# 원 논문 찾기 보강(A3, 측정 전이라 기본 꺼짐): 1 이면 경량 LLM 이 원 논문 제목을 추정해 제목으로도 찾음 / 근거 논문들의 공통 참고문헌을 후보에 더함
AUTO_FETCH_TITLE_GUESS=0
AUTO_FETCH_COMMON_REFS=0
# OpenAlex API 키(선택, openalex.org 에서 무료 발급). 없으면 같은 네트워크가 나눠 쓰는 하루 무료 예산(검색 약 100회)을 써서
# 회사망처럼 여럿이 쓰는 곳에서는 금방 바닥난다(429, 자정 UTC 초기화). 키는 OpenAlex 요청에만 붙는다
OPENALEX_API_KEY=
# 인용 그래프 파일(python scripts/build_citation_graph.py 로 생성, OpenAlex 사용·LLM 없음)
CITATION_GRAPH_PATH=./storage/citation_graph.json
# 1 이면 자동 수집 논문을 검색에서 숨김(삭제 아님). 보통은 0 — 평가 스크립트는 --corpus 로 따로 고른다
EXCLUDE_AUTO_PAPERS=0

# ===========================================================================
# 검색 쪽(로컬 HuggingFace, LLM 백엔드와 무관)
# ===========================================================================
# 임베딩: bge-m3 — 한국어+영어 멀티링구얼
EMBED_MODEL=BAAI/bge-m3
# 실행 장치: auto(GPU 있으면 GPU, fp16) | cuda | cpu
EMBED_DEVICE=auto
RERANK_DEVICE=auto
# 리랭커 GPU fp16(기본 1). 정확도 최우선이면 0 (fp32, VRAM 약 2배)
RERANK_FP16=1
# 리랭커: 크로스인코더
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 벡터 DB 저장 경로
CHROMA_DIR=./storage/chroma

# ===========================================================================
# 환경변수 템플릿 — 복사해서 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env   (Windows: copy .env.example .env)
# ===========================================================================

# --- LLM 백엔드 선택: "anthropic" | "openai" | "local"(OpenAI 호환 로컬 서버) ---
LLM_PROVIDER=anthropic

# 메인 모델(생성·검증, 정확도 중요) / 경량 모델(질의변환 등, 비용 절감)
LLM_MODEL=claude-opus-5-5
LLM_MODEL_LIGHT=claude-haiku-5-5
# 응답 최대 토큰. thinking 모델은 추론 토큰도 여기 포함 → 로컬 thinking 사용 시 8192 이상 권장
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Effort: provider 마다 파라미터 이름과 값 체계가 달라 따로 설정합니다.
#         각각 메인(_없음) / 경량(_LIGHT) 을 분리. 비우면 보내지 않음(기본값 사용).
# ---------------------------------------------------------------------------

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# output_config.effort: low | medium | high | xhigh | max   (opus/haiku 5.x 기본 medium)
ANTHROPIC_EFFORT=
ANTHROPIC_EFFORT_LIGHT=

# --- OpenAI (대안 백엔드) ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-5
# LLM_MODEL_LIGHT=gpt-5-mini
# reasoning_effort: none | minimal | low | medium | high | xhigh  (추론 모델 전용, 지원값은 모델별로 다름)
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_EFFORT_LIGHT=

# --- Local: OpenAI 호환 로컬 서버 (예: FreeToken Local 의 Qwen3.6-35B-A3B) ---
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:8000/v1      # 서버 주소(/v1 까지)
# LOCAL_API_KEY=EMPTY                          # 인증 없는 서버면 아무 값
# LLM_MODEL=Qwen3.6-35B-A3B                    # 서버의 /v1/models 가 돌려주는 id 그대로
# LLM_MODEL_LIGHT=Qwen3.6-35B-A3B
# LLM_TEMPERATURE=0.6                          # Qwen 권장: thinking 0.6 / non-thinking 0.7 (0.0 은 반복 위험)
# Qwen3 계열은 등급형 effort 대신 thinking on | off (chat_template_kwargs.enable_thinking)
LOCAL_THINKING=
LOCAL_THINKING_LIGHT=

# --- 임베딩 모델 (HuggingFace, 로컬) ---
# bge-m3: 한국어+영어 멀티링구얼, 검색 성능 우수
EMBED_MODEL=BAAI/bge-m3

# --- 리랭커 (크로스인코더, 로컬) ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 벡터 DB 저장 경로 ---
CHROMA_DIR=./storage/chroma
